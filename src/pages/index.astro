          "publisher": {"@id": "https://sarl-gcb.netlify.app/#business"}
        }
      ]
    }
    </script>
  </head>

  <body>
    <noscript>
      <div style="padding:2rem;text-align:center;font-family:sans-serif">
        <h1>GCB – Plâtrerie, Isolation RGE &amp; Menuiserie | Annonay (07)</h1>
        <p>Artisan certifié RGE à Annonay, Ardèche. Contactez-nous au 06 74 38 52 39 ou par email : contact@gcb-batiment.fr</p>
      </div>
    </noscript>
    <div class="min-h-screen bg-[#0a0a0a]">
      <Navbar client:load />
      <main>
        <Hero client:load />
        <Services client:visible />
        <About client:visible />
        <Gallery client:visible />
        <Trust client:visible />
        <Zone client:visible />
        <Contact client:visible />
      </main>
      <Footer client:visible />
