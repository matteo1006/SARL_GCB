    <meta name="robots" content="index, follow" />
    <meta name="author" content="GCB" />
    <link rel="canonical" href="https://sarl-gcb.netlify.app/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sarl-gcb.netlify.app/" />
    <meta property="og:title" content="GCB – Plâtrerie, Isolation RGE & Menuiserie | Annonay (07)" />
    <meta property="og:description" content="Artisan certifié RGE depuis 15 ans à Annonay. Plâtrerie, isolation thermique, menuiserie. Devis gratuit sous 48h en Auvergne-Rhône-Alpes." />
