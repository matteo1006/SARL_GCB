    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1768839725085-829e6ac7ac26?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1920" />

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "GeneralContractor",
          "@id": "https://sarl-gcb.netlify.app/#business",
          "name": "GCB",
          "legalName": "SARL GCB",
          "description": "Artisan spécialisé en plâtrerie, isolation thermique RGE et menuiserie depuis plus de 15 ans. Particuliers et professionnels en Auvergne-Rhône-Alpes.",
          "url": "https://sarl-gcb.netlify.app/",
          "telephone": "+33674385239",
          "email": "contact@gcb-batiment.fr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Annonay",
            "addressRegion": "Ardèche",
            "postalCode": "07100",
            "addressCountry": "FR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "45.2400",
            "longitude": "4.6700"
          },
          "areaServed": [
            "Annonay", "Valence", "Lyon", "Saint-Étienne", "Grenoble",
            "Ardèche", "Drôme", "Isère", "Rhône", "Loire", "Auvergne-Rhône-Alpes"
          ],
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
